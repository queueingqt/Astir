# Astir styling for OSM waterways as lines, from tools/osm_import.sh.
BEGIN {
dbfinfo="waterway:name";
dbffields="waterway:name";
}

BEGIN_RECORD {min_display_level=0; key=""; lanes=1; color=12; fill_color=12; name=""; filled=0;
              pattern=0; display_level=32000; label_level=8000; label_color=12;
              font_size=1; symbol=""; fill_style=0;}

/^name=(.*)$/ {name="$1";}

/^waterway=river$/  {lanes=2; display_level=256000; label_level=32000; next}
/^waterway=canal$/  {lanes=2; display_level=64000; next}
/^waterway=stream$/ {lanes=1; display_level=12000; next}
/^waterway=(ditch|drain)$/ {lanes=1; display_level=4000; next}
