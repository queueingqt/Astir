# Astir styling for OSM water bodies as areas, from tools/osm_import.sh.
BEGIN {
dbfinfo="water:name";
dbffields="water:name";
}

BEGIN_RECORD {min_display_level=0; key=""; lanes=1; color=12; fill_color=12; name=""; filled=1;
              fill_style=2; fill_stipple=0; pattern=0; display_level=512000;
              label_level=32000; label_color=12; font_size=1; symbol="";}

/^name=(.*)$/ {name="$1";}
