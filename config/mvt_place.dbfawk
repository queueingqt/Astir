# Astir styling for the "place" layer of a vector tile.
#
# Place features are points that exist to carry a name, so these rules are all
# about label_level -- the zoom at which a name stops being drawn -- and font
# size.  The driver draws the name rather than the point.
#
# The label placer rejects names that would overlap, so two places close
# together no longer collide.  The levels below still fall away sharply, but for
# a different reason now: they decide which names are even OFFERED at a zoom,
# and offering a hamlet at country scale would have it lose to a city anyway.
#
# A pattern and its action must be on the same line; dbfawk reads a rule per
# line, and wrapping one for readability makes both halves parse errors.
BEGIN {
dbfinfo="mvt:place";
dbffields="class:name:rank";
}

BEGIN_RECORD {key=""; lanes=1; color=8; fill_color=8; name=""; filled=0;
              pattern=0; display_level=0; min_display_level=0;
              label_level=12000; label_color=8; font_size=1; symbol="";}

/^name=(.*)$/ {name="$1";}

/^class=continent$/ {font_size=4; label_color=8; label_level=2147483647; next}
/^class=country$/   {font_size=4; label_color=8; label_level=2147483647; next}
/^class=state$/     {font_size=3; label_color=8; label_level=1024000; next}
/^class=province$/  {font_size=3; label_color=8; label_level=512000; next}
/^class=city$/      {font_size=3; label_color=8; label_level=256000; next}
/^class=town$/      {font_size=2; label_color=8; label_level=64000; next}
/^class=village$/   {font_size=2; label_color=8; label_level=24000; next}
/^class=hamlet$/    {font_size=1; label_color=8; label_level=12000; next}
/^class=(suburb|quarter|neighbourhood)$/ {font_size=1; label_color=41; label_level=8000; next}
/^class=island$/    {font_size=2; label_color=26; label_level=64000; next}
